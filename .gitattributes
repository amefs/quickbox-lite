# Normalize every text file to LF on checkout, regardless of the platform
# setting of core.autocrlf. Git still detects binary files, and the explicit
# binary rules below keep their current behavior.
* text=auto eol=lf

# Text files that must stay LF even when edited on Windows.
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
packages/**/* text eol=lf
setup/lang/**/* text eol=lf
setup/templates/**/* text eol=lf

# Denote all files that are truly binary and should not be modified.
*.gif           binary
*.jpg           binary
*.png           binary
*.eot           binary
*.ttf           binary
*.woff          binary
*.woff2         binary

# config for bun lock file
*.lockb binary diff=lockb
