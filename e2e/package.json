{
  "name": "quickbox-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests for QuickBox Lite Dashboard",
  "scripts": {
    "test": "npx playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:report": "npx playwright show-report",
    "e2e": "sh ./scripts/run-e2e.sh",
    "test:deployment": "bash ../tests/deployment/run-linux.sh",
    "test:auth": "bash ../tests/deployment/run-auth.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.15"
  }
}
