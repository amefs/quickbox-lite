if ($request_method = POST) {
  set $no_cache 1;
}

if ($query_string != "") {
  set $no_cache 1;
}

location ~* ^/(?:skins|lib|fonts|img|js|lang)/.*\.(?:css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map|json)$ {
    root /srv/dashboard;
    try_files $uri =404;
    access_log off;
}

location ^~ /db/ {
    satisfy any;
    allow 127.0.0.1;
    deny all;
    auth_basic "password Required";
    auth_basic_user_file /etc/htpasswd;
}

location ^~ /db/master.txt {
    return 404;
}

location ^~ /db/interface.txt {
    return 404;
}

location ^~ /ws {
    satisfy any;
    allow 127.0.0.1;
    deny all;
    auth_basic "password Required";
    auth_basic_user_file /etc/htpasswd;

    proxy_pass http://127.0.0.1:8575;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include snippets/proxy.conf;
    rewrite ^/ws/(.*) /$1 break;
}

location / {
    satisfy any;
    allow 127.0.0.1;
    deny all;
    auth_basic "password Required";
    auth_basic_user_file /etc/htpasswd;

    proxy_pass http://127.0.0.1:8575;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include snippets/proxy.conf;
}
