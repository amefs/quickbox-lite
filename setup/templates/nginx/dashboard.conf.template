if ($request_method = POST) {
  set $no_cache 1;
}

if ($query_string != "") {
  set $no_cache 1;
}

location ~* ^/(?:skins|lib|fonts|img|js|lang)/.*\.(?:css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map|json)$ {
    root /srv/dashboard;
    try_files $uri =404;
    access_log off;
}

# Restricted health probe for local monitoring only. It never proxies to the
# dashboard process and never returns dashboard data, so loopback callers cannot
# use it to bypass user authentication.
location = /qb-healthz {
    if ($remote_addr !~ "^(127\\.0\\.0\\.1|::1)$") { return 403; }
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
}

location ^~ /db/ {
    satisfy any;
    allow 127.0.0.1;
    deny all;
    # qb-auth-begin
    auth_basic "password Required";
    auth_basic_user_file /etc/htpasswd;
}

location ^~ /db/master.txt {
    return 404;
}

location ^~ /db/interface.txt {
    return 404;
}

# Establish Basic Auth's root credential scope before the panel starts API requests.
location = /ws {
    absolute_redirect off;
    return 308 /$is_args$args;
}

location = /ws/ {
    absolute_redirect off;
    return 308 /$is_args$args;
}

# Loopback callers are NOT exempt from user authentication here: the gateway
# secret identifies the proxy, not a logged-in user (see AUTH-01).
location ^~ /ws {
    # qb-auth-begin
    auth_basic "password Required";
    auth_basic_user_file /etc/htpasswd;

    proxy_pass http://127.0.0.1:8575;
    # proxy.conf sets `Connection ""`; the upgrade headers must be applied after
    # the include or WebSocket handshakes lose the Upgrade/Connection pair.
    include snippets/proxy.conf;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include /etc/nginx/snippets/quickbox-ws-gateway.conf;
    rewrite ^/ws/(?P<path>.*) /$path break;
}

location / {
    # qb-auth-begin
    auth_basic "password Required";
    auth_basic_user_file /etc/htpasswd;

    proxy_pass http://127.0.0.1:8575;
    include snippets/proxy.conf;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include /etc/nginx/snippets/quickbox-ws-gateway.conf;
}
