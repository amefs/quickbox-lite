{
  "name": "quickbox-ws",
  "version": "1.5.12",
  "description": "QuickBox Status Update WebSocket Interface",
  "main": "dist/server.js",
  "scripts": {
    "build": "webpack --config build/webpack.config.js",
    "test": "cross-env NODE_ENV=test mocha --exit -r tsx --extensions ts 'tests/**/*.{mts,ts}'",
    "check-type": "tsc --noemit",
    "eslint": "eslint .",
    "lint": "npm run check-type && npm run eslint",
    "dev:server": "tsx watch src/server.tsx",
    "dev:client": "tsx scripts/dev-client.js",
    "dev:dashboard": "node scripts/dev-server.js",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "upgrade": "npx npm-check-updates -i"
  },
  "author": "TautCony",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "axios": "^1.16.0",
    "bignumber.js": "^11.1.1",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "make-plural": "^7.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.31.6",
    "which": "^6.0.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^21.0.1",
    "@types/supertest": "^7.2.0",
    "@types/webpack-node-externals": "^3.0.4",
    "@types/which": "^3.0.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/parser": "^8.59.3",
    "bun-types": "latest",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-webpack-plugin": "^5.0.3",
    "globals": "^17.6.0",
    "http-proxy-middleware": "^4.0.0",
    "mocha": "^11.7.5",
    "sinon": "^22.0.0",
    "socket.io-client": "^4.8.3",
    "source-map-loader": "^5.0.0",
    "supertest": "^7.2.2",
    "terser-webpack-plugin": "^5.6.0",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0",
    "webpackbar": "^7.0.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  }
}
