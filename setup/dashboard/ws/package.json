{
  "name": "quickbox-ws",
  "version": "1.6.1",
  "description": "QuickBox Status Update WebSocket Interface",
  "main": "dist/server.js",
  "scripts": {
    "build": "vite build --config build/vite.config.mjs",
    "test": "cross-env NODE_ENV=test mocha --exit -r tsx --extensions ts 'tests/**/*.{mts,ts}'",
    "check-type": "tsc --noemit",
    "eslint": "eslint .",
    "lint": "npm run check-type && npm run eslint",
    "dev:server": "tsx watch src/server.tsx",
    "dev:client": "tsx scripts/dev-client.js",
    "dev:dashboard": "node scripts/dev-server.js",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "upgrade": "npx npm-check-updates -i"
  },
  "author": "TautCony",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "axios": "^1.20.0",
    "bignumber.js": "^11.1.5",
    "express": "^5.3.0",
    "lodash": "^4.18.1",
    "make-plural": "^8.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "systeminformation": "^5.33.16",
    "which": "^7.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sinon": "^22.0.2",
    "@types/supertest": "^7.2.1",
    "@types/which": "^3.0.4",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/parser": "^8.72.0",
    "bun-types": "latest",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "http-proxy-middleware": "^4.2.1",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  }
}
