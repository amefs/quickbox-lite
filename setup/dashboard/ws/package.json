{
  "name": "quickbox-ws",
  "version": "1.6.1",
  "description": "QuickBox Status Update WebSocket Interface",
  "main": "dist/server.js",
  "scripts": {
    "build": "vite build --config build/vite.config.mjs",
    "test": "cross-env NODE_ENV=test mocha --exit -r tsx --extensions ts 'tests/**/*.{mts,ts}'",
    "check-type": "tsc --noemit",
    "eslint": "eslint .",
    "lint": "npm run check-type && npm run eslint",
    "dev": "QUICKBOX_DEV_SERVER=1 QUICKBOX_REPO_ROOT=${QUICKBOX_REPO_ROOT:-../../..} tsx watch src/server.ts --env=${QUICKBOX_ENV:-mock}",
    "dev:client": "tsx scripts/dev-client.js",
    "dev:dashboard": "node scripts/dev-server.js --env=${QUICKBOX_ENV:-mock}",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "upgrade": "npx npm-check-updates -i"
  },
  "author": "TautCony",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "systeminformation": "^5.33.23",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/sinon": "^22.0.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/parser": "^8.73.0",
    "bun-types": "latest",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "http-proxy-middleware": "^4.2.2",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "optionalDependencies": {
    "bufferutil": "^4.2.0",
    "utf-8-validate": "^6.1.0"
  },
  "allowScripts": {
    "bufferutil@4.2.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "utf-8-validate@6.1.0": true
  }
}
