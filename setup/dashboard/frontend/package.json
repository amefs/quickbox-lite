{
  "name": "@quickbox-dashboard/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server/src/dashboard-page.js",
  "types": "dist/server/src/dashboard-page.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/src/dashboard-page.d.ts",
      "default": "./dist/server/src/dashboard-page.js"
    },
    "./server": {
      "types": "./dist/server/src/dashboard-page.d.ts",
      "default": "./dist/server/src/dashboard-page.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "type-check": "node ../scripts/check-workspace-boundaries.cjs && tsc -p tsconfig.json --noEmit",
    "lint": "npm run type-check",
    "test": "cross-env NODE_ENV=test mocha --exit -r tsx --extensions ts,tsx 'tests/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@quickbox-dashboard/shared": "file:../shared",
    "animate.css": "^4.1.1",
    "ansi_up": "^5.2.1",
    "bootbox": "^5.5.3",
    "bootstrap": "3.4.1",
    "datatables": "^1.10.18",
    "font-awesome": "^4.7.0",
    "gritter": "^1.7.4",
    "jquery": "^3.7.1",
    "jquery-toggles": "^4.0.0",
    "jquery-ui": "^1.14.1",
    "jquery-ui-touch-punch": "^0.2.3",
    "lazysizes": "^5.3.2",
    "lobipanel": "^1.0.0",
    "perfect-scrollbar": "^1.5.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "select2": "^4.0.13",
    "socket.io-client": "^4.8.3",
    "visibilityjs": "^2.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.4",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "mocha": "^11.7.5",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "@types/chai": "^5.2.3",
    "@types/jquery": "^3.5.33",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
