################################################################################
# HELP FUNCTIONS
################################################################################
export NEWT_COLORS='
root=,black
window=,lightgray
shadow=,color8
title=color8,
checkbox=,magenta
entry=,color8
label=blue,
actlistbox=,magenta
actsellistbox=,magenta
helpline=,magenta
roottext=,magenta
emptyscale=magenta
disabledentry=magenta,
'

_norm=$(tput sgr0)
_red=$(tput setaf 1)
_green=$(tput setaf 2)
_tan=$(tput setaf 3)
_cyan=$(tput setaf 6)

function _execute() {
	($1 >>"${OUTTO}" 2>&1)
}
function _print() {
	printf "${_norm}%s${_norm}\n" "$@"
	printf "%s\n" "$@" >>"${OUTTO}"
}
function _info() {
	printf "${_cyan}➜ %s${_norm}\n" "$@"
	printf ">> Info: %s\n" "$@" >>"${OUTTO}"
}
function _success() {
	printf "${_green}✓ %s${_norm}\n" "$@"
	printf ">> Success: %s\n" "$@" >>"${OUTTO}"
}
function _warning() {
	printf "${_tan}⚠ %s${_norm}\n" "$@"
	printf ">> Warning: %s\n" "$@" >>"${OUTTO}"
}
function _error() {
	printf "${_red}✗ %s${_norm}\n" "$@"
	printf ">> Error: %s\n" "$@" >>"${OUTTO}"
}

################################################################################
# APP VARIABLE
################################################################################
APP_TITLE="Vouch Proxy"
APP_NAME="vouchproxy"
APP_SERVICE="vouch-proxy"
APP_LOCK=".${APP_NAME}.lock"
OUTTO="/srv/dashboard/db/output.log"
UPDATE_BACKUP_DIR=""
UPDATE_RUNTIME_PATHS=(
	/opt/vouch-proxy/config.yml
	/opt/vouch-proxy/docker-compose.yml
	/etc/nginx/apps/vouchproxy-auth.conf
)

################################################################################
# SCRIPT FUNCTIONS
################################################################################
function _usage() {
  echo -e "\nQuickBox Lite ${APP_TITLE} Updater"
  echo -e "\nUsage:\n$(basename "$0") [-l logfile]"
  echo "-h, --help               display this help and exit"
  echo "-l, --log <logfile>       specific log file"
}

################################################################################
# UPDATE FUNCTIONS
################################################################################
function _lockCheck() {
	if [[ ! -f "/install/$APP_LOCK" ]]; then
	  _error "${APP_TITLE} hasn't been installed."
	  exit 1
	fi

	if [[ -f "/install/.install.lock" ]]; then
	  _error "Another install process is active."
	  exit 1
	fi
}

function _setLock() {
	if ! echo "${APP_TITLE}" >/install/.install.lock; then
		_error "Cannot take the installation lock."
		exit 1
	fi
	# The installation marker is cleared on exit.
	trap '_clearInstallLock' EXIT
}

# Removes the installation marker when it names this package.
function _clearInstallLock() {
	if [[ -f /install/.install.lock ]] && [[ "$(cat /install/.install.lock 2>/dev/null)" == "${APP_TITLE}" ]]; then
		rm -f /install/.install.lock
	fi
}

function _lockCleanup() {
	_clearInstallLock
}

function _updateInfo() {
	_print "
$APP_TITLE will now be updated.

This process may take a few minutes
Please wait until the process is completed
"
}

# Saves the package configuration and nginx auth snippet.
function _backupRuntime() {
	local dir="$1" path
	for path in "${UPDATE_RUNTIME_PATHS[@]}"; do
		if [[ -f "${path}" ]]; then
			cp -p "${path}" "${dir}/$(basename "${path}")" || return 1
		fi
	done
	return 0
}

function _restoreRuntime() {
	local dir="$1" path rc=0
	if [[ -z "${dir}" || ! -d "${dir}" ]]; then
		return 1
	fi
	for path in "${UPDATE_RUNTIME_PATHS[@]}"; do
		if [[ -f "${dir}/$(basename "${path}")" ]]; then
			if ! cp -p "${dir}/$(basename "${path}")" "${path}"; then
				_error "Cannot restore ${path}"
				rc=1
			fi
		fi
	done
	if ((rc != 0)); then
		return 1
	fi
	_execute "systemctl restart ${APP_SERVICE}" || rc=1
	_execute "nginx -t" || rc=1
	_execute "nginx -s reload" || rc=1
	return "${rc}"
}

function _updateFail() {
	_error "$1"
	if [[ -z "${UPDATE_BACKUP_DIR}" ]]; then
		_error "No configuration was changed; the previous ${APP_TITLE} setup is still in place."
	elif _restoreRuntime "${UPDATE_BACKUP_DIR}"; then
		_error "Restored the saved ${APP_TITLE} configuration files."
	else
		_error "Automatic restore failed; inspect ${UPDATE_BACKUP_DIR} and the update log."
	fi
	_clearInstallLock
	exit 1
}

function _updateApp() {
	_info "Updating ${APP_TITLE} image and restarting service..."
	UPDATE_BACKUP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/vouch-update.XXXXXX") || _updateFail "Cannot create a temporary rollback directory."
	if ! _backupRuntime "${UPDATE_BACKUP_DIR}"; then
		rm -rf "${UPDATE_BACKUP_DIR}"
		UPDATE_BACKUP_DIR=""
		_updateFail "Cannot back up the current ${APP_TITLE} configuration."
	fi
	_execute "docker compose -f /opt/vouch-proxy/docker-compose.yml pull" || _updateFail "Failed to pull the ${APP_TITLE} image."

	if [[ -f "/opt/vouch-proxy/config.yml" ]] && ! grep -q "post_logout_redirect_uris:" /opt/vouch-proxy/config.yml; then
	  _info "Patching Vouch config with post-logout redirect allowlist..."
	  python3 - <<'PYEOF' || _updateFail "Failed to patch the ${APP_TITLE} logout allowlist."
from pathlib import Path
import re

path = Path('/opt/vouch-proxy/config.yml')
text = path.read_text()

login_domain = None
match = re.search(r"^\s*callback_url:\s*'?https://([^/'\s]+)", text, re.M)
if match:
  login_domain = match.group(1).strip()

insert_lines = "\n  post_logout_redirect_uris:\n    - /\n"
if login_domain:
  insert_lines += f"    - https://{login_domain}/\n"

if 'post_logout_redirect_uris:' not in text:
  text = text.replace('oauth:\n', insert_lines + 'oauth:\n', 1)
  path.write_text(text)
PYEOF
	fi

	if [[ -f "/opt/vouch-proxy/config.yml" ]]; then
	  _info "Ensuring end_session_endpoint is allowed in post-logout redirects..."
	  python3 - <<'PYEOF' || _updateFail "Failed to patch the ${APP_TITLE} end-session redirects."
from pathlib import Path
import re

path = Path('/opt/vouch-proxy/config.yml')
text = path.read_text()

end_session = None
match = re.search(r"^\s*end_session_endpoint:\s*['\"]?([^'\"\n]+)['\"]?\s*$", text, re.M)
if match:
  end_session = match.group(1).strip()

if end_session and 'post_logout_redirect_uris:' in text and end_session not in text:
  lines = text.splitlines()
  out = []
  in_post_logout = False
  inserted = False
  for line in lines:
    if re.match(r'^\s*post_logout_redirect_uris:\s*$', line):
      in_post_logout = True
      out.append(line)
      continue

    if in_post_logout and re.match(r'^\s*[A-Za-z0-9_]+\s*:\s*', line):
      if not inserted:
        out.append(f'    - {end_session}')
        inserted = True
      in_post_logout = False

    out.append(line)

  if in_post_logout and not inserted:
    out.append(f'    - {end_session}')
  text = '\n'.join(out) + ('\n' if text.endswith('\n') else '')
  path.write_text(text)
PYEOF
	fi

	_execute "systemctl restart ${APP_SERVICE}" || _updateFail "Failed to restart ${APP_SERVICE}."

	if [[ -f "/etc/nginx/apps/vouchproxy-auth.conf" ]] && ! grep -q "location = /logout" /etc/nginx/apps/vouchproxy-auth.conf; then
	  _info "Patching nginx vouch auth route for logout..."
	  python3 - <<'PYEOF' || _updateFail "Failed to patch the ${APP_TITLE} nginx snippet."
from pathlib import Path

path = Path('/etc/nginx/apps/vouchproxy-auth.conf')
content = path.read_text()

insert = '''location = /logout {
  proxy_pass http://127.0.0.1:9090/logout$is_args$args;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $host;
}

'''

marker = 'location = /auth/vouch/callback {'
if marker in content and 'location = /logout' not in content:
    content = content.replace(marker, insert + marker, 1)
    path.write_text(content)
PYEOF
	fi

	_execute "/usr/local/bin/quickbox/system/auxiliary/qbAuthMigrate --provider vouch --migrate" || _updateFail "Failed to migrate existing authentication configuration."
	_execute "nginx -t" || _updateFail "nginx configuration test failed."
	_execute "nginx -s reload" || _updateFail "Failed to reload nginx."

	rm -rf "${UPDATE_BACKUP_DIR}"
	UPDATE_BACKUP_DIR=""
	_success "${APP_TITLE} updated."
}

################################################################################
# OPT GENERATOR
################################################################################
if ! ARGS=$(getopt -a -o hl: -l help,log: -- "$@"); then
	_usage
	exit 1
fi
eval set -- "${ARGS}"
while true; do
	case "$1" in
	-h | --help)
		_usage
		exit 0
		;;
	-l | --log)
		OUTTO="$2"
		shift
		;;
	--)
		shift
		break
		;;
	esac
	shift
done

################################################################################
# MAIN PROCESS
################################################################################
_lockCheck
_setLock
_updateInfo
_updateApp
_lockCleanup
