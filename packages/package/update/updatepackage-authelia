################################################################################
# HELP FUNCTIONS
################################################################################
export NEWT_COLORS='
root=,black
window=,lightgray
shadow=,color8
title=color8,
checkbox=,magenta
entry=,color8
label=blue,
actlistbox=,magenta
actsellistbox=,magenta
helpline=,magenta
roottext=,magenta
emptyscale=magenta
disabledentry=magenta,
'

_norm=$(tput sgr0)
_red=$(tput setaf 1)
_green=$(tput setaf 2)
_tan=$(tput setaf 3)
_cyan=$(tput setaf 6)

function _execute() {
	($1 >>"${OUTTO}" 2>&1)
}
function _print() {
	printf "${_norm}%s${_norm}\n" "$@"
	printf "%s\n" "$@" >>"${OUTTO}"
}
function _info() {
	printf "${_cyan}➜ %s${_norm}\n" "$@"
	printf ">> Info: %s\n" "$@" >>"${OUTTO}"
}
function _success() {
	printf "${_green}✓ %s${_norm}\n" "$@"
	printf ">> Success: %s\n" "$@" >>"${OUTTO}"
}
function _warning() {
	printf "${_tan}⚠ %s${_norm}\n" "$@"
	printf ">> Warning: %s\n" "$@" >>"${OUTTO}"
}
function _error() {
	printf "${_red}✗ %s${_norm}\n" "$@"
	printf ">> Error: %s\n" "$@" >>"${OUTTO}"
}

################################################################################
# APP VARIABLE
################################################################################
APP_TITLE="Authelia"
APP_NAME="authelia"
APP_SERVICE="authelia"
APP_LOCK=".${APP_NAME}.lock"
OUTTO="/srv/dashboard/db/output.log"
UPDATE_BACKUP_DIR=""
UPDATE_RUNTIME_PATHS=(
	/opt/authelia/docker-compose.yml
	/opt/authelia/configuration.yml
	/etc/nginx/apps/authelia-auth.conf
)

################################################################################
# SCRIPT FUNCTIONS
################################################################################
function _usage() {
  echo -e "\nQuickBox Lite ${APP_TITLE} Updater"
  echo -e "\nUsage:\n$(basename "$0") [-l logfile]"
  echo "-h, --help               display this help and exit"
  echo "-l, --log <logfile>       specific log file"
}

################################################################################
# UPDATE FUNCTIONS
################################################################################
function _lockCheck() {
	if [[ ! -f "/install/$APP_LOCK" ]]; then
	  _error "${APP_TITLE} hasn't been installed."
	  exit 1
	fi

	if [[ -f "/install/.install.lock" ]]; then
	  _error "Another install process is active."
	  exit 1
	fi
}

function _setLock() {
	if ! echo "${APP_TITLE}" >/install/.install.lock; then
		_error "Cannot take the installation lock."
		exit 1
	fi
	# The installation marker is cleared on exit.
	trap '_clearInstallLock' EXIT
}

# Removes the installation marker when it names this package.
function _clearInstallLock() {
	if [[ -f /install/.install.lock ]] && [[ "$(cat /install/.install.lock 2>/dev/null)" == "${APP_TITLE}" ]]; then
		rm -f /install/.install.lock
	fi
}

function _lockCleanup() {
	_clearInstallLock
}

function _updateInfo() {
	_print "
$APP_TITLE will now be updated.

This process may take a few minutes
Please wait until the process is completed
"
}

# Saves the package configuration and nginx auth snippet.
function _backupRuntime() {
	local dir="$1" path
	for path in "${UPDATE_RUNTIME_PATHS[@]}"; do
		if [[ -f "${path}" ]]; then
			cp -p "${path}" "${dir}/$(basename "${path}")" || return 1
		fi
	done
	return 0
}

function _restoreRuntime() {
	local dir="$1" path rc=0
	if [[ -z "${dir}" || ! -d "${dir}" ]]; then
		return 1
	fi
	for path in "${UPDATE_RUNTIME_PATHS[@]}"; do
		if [[ -f "${dir}/$(basename "${path}")" ]]; then
			if ! cp -p "${dir}/$(basename "${path}")" "${path}"; then
				_error "Cannot restore ${path}"
				rc=1
			fi
		fi
	done
	if ((rc != 0)); then
		return 1
	fi
	_execute "chown -R www-data:www-data /opt/authelia" || rc=1
	_execute "systemctl restart ${APP_SERVICE}" || rc=1
	_execute "nginx -t" || rc=1
	_execute "nginx -s reload" || rc=1
	return "${rc}"
}

function _updateFail() {
	_error "$1"
	if [[ -z "${UPDATE_BACKUP_DIR}" ]]; then
		_error "No configuration was changed; the previous ${APP_TITLE} setup is still in place."
	elif _restoreRuntime "${UPDATE_BACKUP_DIR}"; then
		_error "Restored the saved ${APP_TITLE} configuration files."
	else
		_error "Automatic restore failed; inspect ${UPDATE_BACKUP_DIR} and the update log."
	fi
	_clearInstallLock
	exit 1
}

function _updateApp() {
	_info "Updating ${APP_TITLE} image and restarting service..."
	UPDATE_BACKUP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/authelia-update.XXXXXX") || _updateFail "Cannot create a temporary rollback directory."
	if ! _backupRuntime "${UPDATE_BACKUP_DIR}"; then
		rm -rf "${UPDATE_BACKUP_DIR}"
		UPDATE_BACKUP_DIR=""
		_updateFail "Cannot back up the current ${APP_TITLE} configuration."
	fi

	if [[ -f "/opt/authelia/docker-compose.yml" ]]; then
	  _info "Ensuring ${APP_TITLE} compose runtime user is www-data..."
	  authelia_uid=$(id -u www-data) || _updateFail "The www-data user is missing."
	  authelia_gid=$(id -g www-data) || _updateFail "The www-data group is missing."
	  python3 - "$authelia_uid" "$authelia_gid" <<'PYEOF' || _updateFail "Failed to rewrite the ${APP_TITLE} compose user."
from pathlib import Path
import re
import sys

uid = sys.argv[1]
gid = sys.argv[2]
path = Path('/opt/authelia/docker-compose.yml')
text = path.read_text()

if re.search(r'^\s*user:\s*"?\d+:\d+"?\s*$', text, re.M):
    text = re.sub(r'^\s*user:\s*"?\d+:\d+"?\s*$', f'    user: "{uid}:{gid}"', text, flags=re.M)
else:
    marker = '    container_name: authelia\n'
    if marker in text:
        text = text.replace(marker, marker + f'    user: "{uid}:{gid}"\n', 1)

path.write_text(text)
PYEOF
	  _execute "chown -R www-data:www-data /opt/authelia" || _updateFail "Failed to hand /opt/authelia to www-data."
	fi

	if [[ -f "/opt/authelia/configuration.yml" ]]; then
	  _info "Applying ${APP_TITLE} base-path compatibility settings..."
	  python3 - <<'PYEOF' || _updateFail "Failed to rewrite the ${APP_TITLE} configuration."
from pathlib import Path
import re

path = Path('/opt/authelia/configuration.yml')
text = path.read_text()
text = re.sub(
    r'(?m)^(\s*address:\s*)tcp://0\.0\.0\.0:9091\s*$',
    r'\1tcp://0.0.0.0:9091/authelia',
    text,
)
path.write_text(text)
PYEOF
	fi

	if [[ -f "/etc/nginx/apps/authelia-auth.conf" ]]; then
	  _info "Applying modern ${APP_TITLE} auth_request redirect flow..."
	  python3 - <<'PYEOF' || _updateFail "Failed to rewrite the ${APP_TITLE} nginx snippet."
from pathlib import Path
import re

path = Path('/etc/nginx/apps/authelia-auth.conf')
text = path.read_text()

text = re.sub(
    r'(?ms)^location\s+@qb_authelia_signin\s*\{.*?\}\n\n?',
    '',
    text,
)

text = re.sub(
  r'(?m)^\s*proxy_set_header\s+X-Forwarded-Uri\s+\$request_uri;\s*$',
  '  proxy_set_header X-Forwarded-URI $request_uri;',
    text,
)

if 'proxy_set_header X-Forwarded-URI $request_uri;' not in text:
  text = text.replace(
    '  proxy_set_header X-Forwarded-Host $host;\n',
    '  proxy_set_header X-Forwarded-Host $host;\n  proxy_set_header X-Forwarded-URI $request_uri;\n',
    1,
  )

if 'proxy_set_header Connection "";' not in text:
  text = text.replace(
      '  proxy_set_header Content-Length "";\n',
      '  proxy_set_header Content-Length "";\n  proxy_set_header Connection "";\n',
      1,
  )

if 'proxy_set_header X-Forwarded-Method $request_method;' not in text:
  text = text.replace(
      '  proxy_set_header X-Original-URL $scheme://$http_host$request_uri;\n',
      '  proxy_set_header X-Original-URL $scheme://$http_host$request_uri;\n  proxy_set_header X-Forwarded-Method $request_method;\n',
      1,
  )

path.write_text(text)
PYEOF
	fi

	_execute "/usr/local/bin/quickbox/system/auxiliary/qbAuthMigrate --restore" || _updateFail "Failed to restore the previous authentication configuration."
	_execute "/usr/local/bin/quickbox/system/auxiliary/qbAuthMigrate --provider authelia --migrate" || _updateFail "Failed to migrate existing authentication configuration."

	_execute "docker compose -f /opt/authelia/docker-compose.yml pull" || _updateFail "Failed to pull the ${APP_TITLE} image."
	_execute "systemctl restart ${APP_SERVICE}" || _updateFail "Failed to restart ${APP_SERVICE}."
	_execute "nginx -t" || _updateFail "nginx configuration test failed."
	_execute "nginx -s reload" || _updateFail "Failed to reload nginx."

	rm -rf "${UPDATE_BACKUP_DIR}"
	UPDATE_BACKUP_DIR=""
	_success "${APP_TITLE} updated."
}

################################################################################
# OPT GENERATOR
################################################################################
if ! ARGS=$(getopt -a -o hl: -l help,log: -- "$@"); then
	_usage
	exit 1
fi
eval set -- "${ARGS}"
while true; do
	case "$1" in
	-h | --help)
		_usage
		exit 0
		;;
	-l | --log)
		OUTTO="$2"
		shift
		;;
	--)
		shift
		break
		;;
	esac
	shift
done

################################################################################
# MAIN PROCESS
################################################################################
_lockCheck
_setLock
_updateInfo
_updateApp
_lockCleanup
