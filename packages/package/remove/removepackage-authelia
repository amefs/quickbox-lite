################################################################################

################################################################################
# CORE VARIABLE
################################################################################
set -euo pipefail

################################################################################
# HELP FUNCTIONS
################################################################################
export NEWT_COLORS='
root=,black
window=,lightgray
shadow=,color8
title=color8,
checkbox=,magenta
entry=,color8
label=blue,
actlistbox=,magenta
actsellistbox=,magenta
helpline=,magenta
roottext=,magenta
emptyscale=magenta
disabledentry=magenta,
'

_norm=$(tput sgr0)
_red=$(tput setaf 1)
_green=$(tput setaf 2)
_tan=$(tput setaf 3)
_cyan=$(tput setaf 6)

function _execute() {
	($1 >>"${OUTTO}" 2>&1)
}
function _print() {
	printf "${_norm}%s${_norm}\n" "$@"
	printf "%s\n" "$@" >>"${OUTTO}"
}
function _info() {
	printf "${_cyan}➜ %s${_norm}\n" "$@"
	printf ">> Info: %s\n" "$@" >>"${OUTTO}"
}
function _success() {
	printf "${_green}✓ %s${_norm}\n" "$@"
	printf ">> Success: %s\n" "$@" >>"${OUTTO}"
}
function _warning() {
	printf "${_tan}⚠ %s${_norm}\n" "$@"
	printf ">> Warning: %s\n" "$@" >>"${OUTTO}"
}
function _error() {
	printf "${_red}✗ %s${_norm}\n" "$@"
	printf ">> Error: %s\n" "$@" >>"${OUTTO}"
}

################################################################################
# APP VARIABLE
################################################################################
APP_TITLE="Authelia"
APP_NAME="authelia"
APP_SERVICE="authelia"
APP_LOCK=".${APP_NAME}.lock"
OUTTO="/srv/dashboard/db/output.log"
RESTORE_AUTH=1

################################################################################
# SCRIPT FUNCTIONS
################################################################################
function _usage() {
  echo -e "\nQuickBox Lite ${APP_TITLE} Remover"
  echo -e "\nUsage:\n$(basename "$0") [-l logfile]"
  echo -e "\nOptions:\n"
  echo "-l, --log <logfile>          specific log file"
  echo "--no-restore-auth            skip restoring auth integration on removal"
  echo "-h, --help               display this help and exit"
}

################################################################################
# REMOVE FUNCTIONS
################################################################################
function _lockCheck() {
	if [[ ! -f "/install/$APP_LOCK" ]]; then
	  _error "${APP_TITLE} hasn't been installed."
	  exit 1
	fi

	if [[ -f "/install/.install.lock" ]]; then
	  _error "Another install process is active."
	  exit 1
	fi
}

function _setLock() {
	echo "${APP_TITLE}" >/install/.install.lock
}

function _lockCleanup() {
	rm -f /install/.install.lock
}

function _removeInfo() {
	_print "
$APP_TITLE will now be removed.

This process may take a few minutes
Please wait until the process is completed
"
}

function _removeAppLock() {
	rm -f "/install/${APP_LOCK}"
}

function _removeApp() {
	_info "Stopping ${APP_TITLE} service..."
	_execute "systemctl disable ${APP_SERVICE}"
	_execute "systemctl stop ${APP_SERVICE}"
	_execute "docker compose -f /opt/authelia/docker-compose.yml down"
	rm -f /etc/systemd/system/${APP_SERVICE}.service
	_execute "systemctl daemon-reload"

	_info "Cleaning nginx integration..."
	rm -f /etc/nginx/apps/authelia-auth.conf
	rm -f /etc/nginx/conf.d/authelia-user-map.conf
	if [[ "$RESTORE_AUTH" == "1" ]]; then
	  _execute "/usr/local/bin/quickbox/system/auxiliary/qbAuthMigrate --restore"
	fi
	_execute "nginx -t"
	_execute "nginx -s reload"

	rm -rf /opt/authelia

	_success "${APP_TITLE} removed."
}

################################################################################
# OPT GENERATOR
################################################################################
if ! ARGS=$(getopt -a -o hl: -l help,log:,no-restore-auth -- "$@"); then
	_usage
	exit 1
fi
eval set -- "${ARGS}"
while true; do
	case "$1" in
	-h | --help)
		_usage
		exit 0
		;;
	-l | --log)
		OUTTO="$2"
		shift
		;;
	--no-restore-auth)
		RESTORE_AUTH=0
		;;
	--)
		shift
		break
		;;
	esac
	shift
done

################################################################################
# MAIN PROCESS
################################################################################
_lockCheck
_setLock
_removeInfo
_removeApp
_removeAppLock
_lockCleanup
