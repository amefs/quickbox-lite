# The clock is shared with qbUpdate and qbUpdateDashboard. Standalone
# invocation (tests or a manual run) resolves the file next to this script.
_qb_timer_lib="${QB_UPDATE_TIMER_LIB:-/usr/local/bin/quickbox/system/update/qbUpdateTimer}"
if [[ ! -f "${_qb_timer_lib}" ]]; then
	_qb_timer_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/qbUpdateTimer"
fi
if [[ -f "${_qb_timer_lib}" ]]; then
	# shellcheck source=packages/system/update/qbUpdateTimer
	# shellcheck disable=SC1090,SC1091
	source "${_qb_timer_lib}"
else
	printf '⚠ Update timing helper is missing: %s\n' "${_qb_timer_lib}" >&2
	function _qbNowMs() { printf '0\n'; }
	function _qbFormatMs() { printf '%d.0s\n' "$(( ${1:-0} / 1000 ))"; }
	function _qbReportMs() { return 0; }
	function _qbReportLap() { return 0; }
	function _qbTouchActivity() { return 0; }
fi

# Output policy: a helper that succeeds is a detail, a helper that fails is the
# diagnosis. Standalone invocation resolves the file next to this script too.
_qb_step_lib="${QB_UPDATE_STEP_LIB:-/usr/local/bin/quickbox/system/update/qbUpdateStep}"
if [[ ! -f "${_qb_step_lib}" ]]; then
	_qb_step_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/qbUpdateStep"
fi
if [[ -f "${_qb_step_lib}" ]]; then
	# shellcheck source=packages/system/update/qbUpdateStep
	# shellcheck disable=SC1090,SC1091
	source "${_qb_step_lib}"
else
	function _qbIsVerbose() { return 1; }
	function _qbRunHelper() { local message="$1"; shift; "$@"; }
	function _qbDetail() { return 0; }
fi

function _execute() {
	($1 >>"${OUTTO}" 2>&1)
}
# Inside an update these printers already exist: qbUpdate defines them and uses
# them to refresh its progress window, so redefining them here would silently
# drop that tracking. A standalone run (tests, manual invocation) still needs a
# local copy.
if [[ $(type -t _info) != function ]]; then
	function _print() {
		printf "${_norm}%s${_norm}\n" "$@"
		printf "%s\n" "$@" >>"${OUTTO}"
	}
	function _info() {
		printf "${_cyan}➜ %s${_norm}\n" "$@"
		printf ">> Info: %s\n" "$@" >>"${OUTTO}"
	}
	function _success() {
		printf "${_green}✓ %s${_norm}\n" "$@"
		printf ">> Success: %s\n" "$@" >>"${OUTTO}"
	}
	function _warning() {
		printf "${_tan}⚠ %s${_norm}\n" "$@"
		printf ">> Warning: %s\n" "$@" >>"${OUTTO}"
	}
	function _error() {
		printf "${_red}✗ %s${_norm}\n" "$@"
		printf ">> Error: %s\n" "$@" >>"${OUTTO}"
	}
fi

function _verlte() {
	[  "$1" = "$(echo -e "$1\n$2" | sort -V | head -n1)" ]
}

function _verlt() {
	if [ "$1" = "$2" ]; then
		return 1
	else
		_verlte "$1" "$2"
	fi
}

function _download_latest_ttyd() {
	ttyd_binary_url=$(curl -s https://api.github.com/repos/tsl0922/ttyd/releases/latest | jq -r ".assets[] | select(.name | contains(\"$(arch)\")) | .browser_download_url") >>"${OUTTO}" 2>&1
	if wget -qO /usr/local/bin/ttyd.new "${ttyd_binary_url}"; then
		chmod +x /usr/local/bin/ttyd.new
		if /usr/local/bin/ttyd.new -v > /dev/null; then
			mv -f /usr/local/bin/ttyd.new /usr/local/bin/ttyd >>"${OUTTO}" 2>&1
			echo "ttyd binary download success" >>"${OUTTO}" 2>&1
		else
			/usr/local/bin/ttyd.new -v >>"${OUTTO}" 2>&1
			rm -f /usr/local/bin/ttyd.new >>"${OUTTO}" 2>&1
			echo "downloaded ttyd file corrupted" >>"${OUTTO}" 2>&1
		fi
	else
		echo "ttyd binary download failed" >>"${OUTTO}" 2>&1
	fi
}

function _fix_nginx_app_include() {
	local nginx_default="/etc/nginx/sites-enabled/default"
	if [[ ! -f "${nginx_default}" ]]; then
		return 0
	fi
	if (grep -Eq '^[[:space:]]*include[[:space:]]+/etc/nginx/apps/\*;' < "${nginx_default}"); then
		_info "Updating Nginx app include pattern..."
		local backup
		backup=$(mktemp) || return 1
		cp -p "${nginx_default}" "${backup}" || { rm -f "${backup}"; return 1; }
		sed -i 's#^\([[:space:]]*include[[:space:]]\+\)/etc/nginx/apps/\*;#\1/etc/nginx/apps/*.conf;#' "${nginx_default}" || { cp -p "${backup}" "${nginx_default}"; rm -f "${backup}"; return 1; }
		if ! _execute "nginx -t" || ! _execute "nginx -s reload"; then
			cp -p "${backup}" "${nginx_default}" || return 1
			rm -f "${backup}"
			_execute "nginx -t" && _execute "nginx -s reload" || return 1
			return 1
		fi
		rm -f "${backup}"
		_success "Nginx app include pattern updated"
	fi
}

function _updateservice() {
	_info "Updating QuickBox service..."
	local lap ttyd_status
	local -a node_args=()
	# Older installs may not grant www-data the managed command set, or may
	# leave the sudoers files with modes that sudo reports as invalid. Repair
	# the managed policy before the downgraded WS service depends on it.
	lap=$(_qbNowMs)
	if ! _qbRunHelper "Failed to install the dashboard sudoers policy" \
		bash /usr/local/bin/quickbox/system/auxiliary/qbEnsureSudoers; then
		return 1
	fi
	_qbReportLap "sudoers policy" "${lap}"
	lap=$(_qbNowMs)
	_fix_nginx_app_include || return 1
	_qbReportLap "nginx app include" "${lap}"
	# Refresh the system runtime even when Node.js 24 is already installed.
	# The dashboard updater stages dependencies and restarts the service only
	# after the new runtime is ready.
	#
	# `--only-core` is the recovery path after a partial or failed update, and
	# it may run on a slow link: it only asks whether the installed runtime
	# still satisfies the policy instead of fetching patches again.
	if [[ ${QB_UPDATE_ONLY_CORE:-0} -eq 1 ]]; then
		_info "Checking Node.js 24..."
		node_args=(--reuse)
	else
		_info "Installing or updating Node.js 24..."
	fi
	lap=$(_qbNowMs)
	if ! _qbRunHelper "Failed to install or update Node.js 24" \
		bash /usr/local/bin/quickbox/system/auxiliary/qbEnsureNodejs \
		${node_args[@]+"${node_args[@]}"}; then
		return 1
	fi
	_qbReportLap "Node.js 24" "${lap}"
	lap=$(_qbNowMs)
	_qbDetail "Dashboard dependency activation is deferred to the staged dashboard update"
	# Update flexget nginx reverse proxy
	username=$(cat /root/.admin.info | cut -d: -f1)
	if [[ -f /etc/nginx/apps/${username}.flexget.conf ]]; then
		if (! grep -c 'location /flexget' < /etc/nginx/apps/${username}.flexget.conf > /dev/null); then
			_info "Reconfig FlexGet reverse proxy..."
			sed -i "s/location \/${username}.flexget\//location \/flexget\//g" /etc/nginx/apps/${username}.flexget.conf
			_success "FlexGet reverse proxy updated..."
		fi
	fi
	if [[ -f /install/.lecert.lock ]]; then
		if [[ ! -f /install/domain.info ]]; then
			cat /etc/nginx/sites-enabled/default | grep server_name | head -n 1 | tr -s ' ' | cut -d ' ' -f 3 | sed -e "s/;//" >> /install/domain.info
		fi
	fi
	if ( grep -c '/install/domain.info' < /etc/profile > /dev/null); then
		sed -i '/echo " Welcome Back !"/,7d' /etc/profile
		# Install screenfetch command
		if [[ $(dpkg -s screenfetch 2> /dev/null | grep -cow '^Status: install ok installed$') -eq '0' ]]; then
			DEBIAN_FRONTEND=noninteractive apt-get -yqq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" update >>"${OUTTO}" 2>&1
			DEBIAN_FRONTEND=noninteractive apt-get -y install screenfetch --allow-unauthenticated >>"${OUTTO}" 2>&1 || { local dependError=1; }
		fi
		chmod -x /etc/update-motd.d/*
		\cp -f ${local_setup_template}motd/01-custom /etc/update-motd.d/01-custom
		chmod +x /etc/update-motd.d/01-custom
	else
		\cp -f ${local_setup_template}motd/01-custom /etc/update-motd.d/01-custom
		chmod +x /etc/update-motd.d/01-custom
	fi
	# Install at command
	if [[ $(dpkg -s at 2> /dev/null | grep -cow '^Status: install ok installed$') -eq '0' ]]; then
		DEBIAN_FRONTEND=noninteractive apt-get -yqq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" update >>"${OUTTO}" 2>&1
		DEBIAN_FRONTEND=noninteractive apt-get -y install at --allow-unauthenticated >>"${OUTTO}" 2>&1 || { local dependError=1; }
	fi
	# Replace webshell
	if (! which jq > /dev/null); then
		_execute "apt-get install -y jq"
	fi
	_qbReportLap "motd and helper packages" "${lap}"
	# The ttyd block talks to the GitHub API, which is the part of this stage
	# most likely to be slow on a restricted network.
	lap=$(_qbNowMs)
	if [[ ! -f /etc/systemd/system/ttyd.service ]]; then
		_info "replace shellinabox with ttyd"
		# stop shellinabox
		_execute "systemctl stop shellinabox.service"
		_execute "systemctl disable shellinabox.service"
		rm -f /install/.shellinabox.lock >/dev/null 2>&1
		_execute "apt-get remove -y shellinabox"

		# install ttyd and service config
		_download_latest_ttyd
		service ttyd stop >/dev/null 2>&1
		rm -f /etc/init.d/ttyd >/dev/null 2>&1

		cat > /etc/nginx/apps/"${username}".console.conf <<WEBC
location /${username}.console/ {
	proxy_pass http://127.0.0.1:4200;
	rewrite ^/${username}.console(?P<path>.*) /\$path break;
$(bash /usr/local/bin/quickbox/system/auxiliary/qbNginxAuth proxy "/etc/htpasswd" "	")
	proxy_set_header Upgrade \$http_upgrade;
	proxy_set_header Connection "upgrade";
}
WEBC
		cp ${local_setup_template}systemd/ttyd.service.template /etc/systemd/system/ttyd.service
		sed -i "s/USERNAME/${username}/g" /etc/systemd/system/ttyd.service

		# enable ttyd service
		_execute "systemctl daemon-reload"
		_execute "systemctl enable ttyd.service"
		_execute "systemctl start ttyd.service"
		# create lock
		touch /install/.ttyd.lock
	fi
	# check ttyd update
	if ! which ttyd > /dev/null; then
		_warning "ttyd do not exists"
	fi
	local current_version
	local latest_version
	current_version=$(ttyd -v | awk '{print $3}') 2> /dev/null
	current_version=${current_version%-*}
	latest_version=$(curl -s https://api.github.com/repos/tsl0922/ttyd/releases/latest | jq -r ".tag_name")
	_qbDetail "ttyd current version: ${current_version}, latest version: ${latest_version}"
	if (_verlt "$current_version" "$latest_version"); then
		_info "Updating ttyd: ${current_version} -> ${latest_version}"
		_download_latest_ttyd
		_execute "systemctl restart ttyd.service"
		_info "ttyd update success"
	fi
	# enable writable ttyd
	if (grep -c 'ExecStart=/usr/local/bin/ttyd -i 127.0.0.1 -p 4200 bash' < /etc/systemd/system/ttyd.service > /dev/null); then
		cp ${local_setup_template}systemd/ttyd.service.template /etc/systemd/system/ttyd.service
		sed -i "s/USERNAME/${username}/g" /etc/systemd/system/ttyd.service
		_execute "systemctl daemon-reload"
		_execute "systemctl restart ttyd.service"
	fi
	ttyd_status=$?
	_qbReportLap "ttyd" "${lap}"
	if [[ ${ttyd_status} -ne 0 ]]; then
		return "${ttyd_status}"
	fi
	_success "QuickBox service updated"
	return 0
}

function _startservice() {
	# service is already restarted by _updatedashboard during the update process.
	# No delayed restart needed — restarting after "update complete" degrades UX.
	return 0
}
