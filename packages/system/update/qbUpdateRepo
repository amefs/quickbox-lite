function _execute() {
	($1 >>"${OUTTO}" 2>&1)
}
function _print() {
	printf "${_norm}%s${_norm}\n" "$@"
	printf "%s\n" "$@" >>"${OUTTO}"
}
function _info() {
	printf "${_cyan}➜ %s${_norm}\n" "$@"
	printf ">> Info: %s\n" "$@" >>"${OUTTO}"
}
function _success() {
	printf "${_green}✓ %s${_norm}\n" "$@"
	printf ">> Success: %s\n" "$@" >>"${OUTTO}"
}
function _warning() {
	printf "${_tan}⚠ %s${_norm}\n" "$@"
	printf ">> Warning: %s\n" "$@" >>"${OUTTO}"
}
function _error() {
	printf "${_red}✗ %s${_norm}\n" "$@"
	printf ">> Error: %s\n" "$@" >>"${OUTTO}"
}

function _updateRepo() {
	_info "Updating QuickBox local repository..."
	local repo="${QUICKBOX_REPO_ROOT:-/etc/QuickBox}" branch state_branch changes
	if [[ -n ${update_target_branch:-} ]]; then
		branch=${update_target_branch}
	elif [[ -s /install/.quickbox-branch ]]; then
		IFS= read -r state_branch </install/.quickbox-branch
		branch=${state_branch}
	elif [[ -f /install/.legacy.lock ]]; then
		branch=legacy
	elif [[ -f /install/.developer.lock ]]; then
		branch=development
		if [[ -f /install/.debug.lock && -d ${repo}/.git ]]; then
			branch=$(git -C "${repo}" symbolic-ref --short -q HEAD) || return 1
		fi
	else
		branch=master
	fi
	if [[ ${branch} == detached && -z ${update_target_branch:-} ]]; then
		_error "The installed checkout is detached. Select a branch with box switch-branch. Essential updates cannot select a branch automatically."
		return 1
	fi
	if [[ ${branch} == -* ]] || ! git check-ref-format --branch "${branch}" >/dev/null 2>&1; then
		_error "Invalid branch: ${branch}"
		return 1
	fi
	if [[ ! -e ${repo} ]]; then
		_info "Cloning QuickBox repository"
		git clone --recursive --branch "${branch}" https://github.com/amefs/quickbox-lite.git "${repo}" >>"${OUTTO}" 2>&1 || return 1
	fi
	if [[ ! -d ${repo}/.git ]]; then
		_error "QuickBox repository is not a git checkout: ${repo}"
		return 1
	fi
	if [[ -n ${update_target_branch:-} ]]; then
		changes=$(git -C "${repo}" status --porcelain --untracked-files=no) || return 1
		if [[ -n ${changes} ]]; then
			_error "Tracked repository files have local changes. Restore or save them before switching branches."
			return 1
		fi
	fi
	_info "Fetching origin/${branch}"
	git -C "${repo}" fetch origin "+refs/heads/${branch}:refs/remotes/origin/${branch}" >>"${OUTTO}" 2>&1 || return 1
	git -C "${repo}" checkout -B "${branch}" "refs/remotes/origin/${branch}" >>"${OUTTO}" 2>&1 || return 1
	git -C "${repo}" reset --hard "refs/remotes/origin/${branch}" >>"${OUTTO}" 2>&1 || return 1
	git -C "${repo}" submodule update --init --recursive >>"${OUTTO}" 2>&1 || return 1

	# File modes and line endings are repaired by _setPerm, which runs next.
	if [[ ! -f /install/.cdn.lock ]]; then
		echo "github" > /install/.cdn.lock
	fi
	_success "QuickBox local repository updated"
}

function _setPerm() {
	_info "Adjust file permission..."
	# Rebuild the executable contract from the shebang of every tracked file
	# instead of marking the whole package tree executable. This keeps data and
	# asset files non-executable and never walks .git or untracked node_modules.
	local repo_root="${QUICKBOX_REPO_ROOT:-${local_prefix:-/etc/QuickBox}}"
	repo_root="${repo_root%/}"
	local normalize_helper="${repo_root}/packages/system/auxiliary/qbNormalizeRepo"
	if [[ -s "${normalize_helper}" ]]; then
		# Strip CR before bash parses the helper. Direct execution fails on a
		# CRLF shebang, and `source` cannot repair the file before parsing it.
		local normalize_script
		normalize_script=$(sed 's/\r$//' "${normalize_helper}") || return 1
		QB_NORMALIZE_BOOTSTRAP=1 QB_NORMALIZE_RUN=1 \
			bash -c "${normalize_script}" _ "${repo_root}" || return 1
	elif [[ -f /install/.legacy.lock ]]; then
		# The legacy branch predates the normalizer. Keep that migration path
		# alive, but scope the repair to packages/ and never chmod data files.
		_warning "Legacy branch has no repository normalizer; using scoped legacy repair"
		local file line
		while IFS= read -r -d '' file; do
			if grep -Iq $'\r' "${file}" 2>/dev/null; then
				dos2unix "${file}" >/dev/null 2>&1 || return 1
			fi
			line=""
			IFS= read -r -n 2 line <"${file}" 2>/dev/null || true
			if [[ "${line}" == '#!' ]]; then
				chmod 0755 "${file}" || return 1
			fi
		done < <(find "${repo_root}/packages" \
			\( -name .git -o -name node_modules \) -prune -o \
			-type f -print0 2>/dev/null)
	else
		_error "Repository normalizer is missing or empty: ${normalize_helper}"
		return 1
	fi
	_success "file permission updated"
}

function _bashrc() {
	_info "Updating bashrc..."
	mv /root/.bash_qb /root/.bash_qb.bak || return 1
	\cp -f "${local_setup_template}"bash_qb.template /root/.bash_qb || return 1
	if [ -f /root/.bash_qb_extras ]; then
		mv /root/.bash_qb_extras /root/.bash_qb_extras.bak || return 1
	fi
	\cp -f "${local_setup_template}"bash_qb_extras.template /root/.bash_qb_extras || return 1
	_success "bashrc updated"
}

function _updateskel() {
	_info "Updating skel..."
	local skel_dir="${QUICKBOX_SKEL_DIR:-/etc/skel}"
	if [[ ! -d "${skel_dir}" ]]; then
		mkdir -p "${skel_dir}" || return 1
	fi
	_execute "rsync -aP ${local_setup_template}skel/. ${skel_dir}/" || return 1
	_success "skel updated"
}
