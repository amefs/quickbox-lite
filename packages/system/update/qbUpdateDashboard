#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Dashboard update step for qbUpdate. Every step reports its own failure so the
# caller never reports "update finished" after a partial deployment.

_qb_lib_dir="${QB_UPDATE_LIB_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)}"
# shellcheck source=packages/system/update/qbUpdateLib
# shellcheck disable=SC1090,SC1091
source "${_qb_lib_dir}/qbUpdateLib"

if ! _qbSourceLib qbUpdateBackup; then
	printf '✗ Update backup helper is missing: %s\n' "${_qb_lib_dir}/qbUpdateBackup" >&2
	return 1
fi

# Copies every existing path into a timestamped rollback directory. The shared
# helper also records mode/owner and a SHA-256 checksum.
function _dashboardBackup() {
	local backup_dir="$1"
	shift
	_qbBackupCreate "${backup_dir}" "$@"
}

# Restores a single backed-up file when activation failed.
function _dashboardRestore() {
	local backup_dir="$1"
	local original="$2"
	_qbBackupRestorePath "${backup_dir}" "${original}"
}

# Returns an unused backup directory name, so two runs in the same second never
# share (and overwrite) one rollback copy.
function _dashboardBackupDir() {
	_qbBackupUniqueDir "$1"
}

# Prepare a complete replacement away from the live tree. This function only
# mutates the staging path, so callers can safely report an npm/rsync failure.
function _dashboardPrepareStage() {
	local live="$1" stage="$2" source="$3" runtime_file lap
	lap=$(_qbNowMs)
	rm -rf "${stage}" || return 1
	mkdir -p "${stage}" || return 1
	rsync -a "${live}/" "${stage}/" || return 1
	rsync -a --delete --exclude=output.log --exclude=output.log.epoch --exclude=interface.txt --exclude=master.txt --exclude=ws.secret --exclude=nginx-ws-gateway.conf --exclude=.smoked.lock --exclude=.defaulted.lock --exclude=custom.css --exclude=update.pid --exclude=update.state --exclude=db/tmp "${source}"* "${stage}/" || return 1
	install -d -m 0700 -o www-data -g www-data "${stage}/db/tmp" || return 1
	_qbReportLap "dashboard stage files (rsync)" "${lap}"
	# Dependency installation is the slowest part of a dashboard update; keep it
	# visible on its own so a slow mirror is not mistaken for a hung update.
	lap=$(_qbNowMs)
	(cd "${stage}/ws" && npm ci --production >>"${OUTTO}" 2>&1) || return 1
	_qbReportLap "dashboard dependencies (npm ci)" "${lap}"
	# Keep open runtime file descriptors (especially the updater's output.log)
	# attached to the path in the newly activated tree by sharing their inode.
	for runtime_file in output.log output.log.epoch interface.txt master.txt update.pid update.state; do
		if [[ -f "${live}/db/${runtime_file}" ]]; then
			rm -f "${stage}/db/${runtime_file}" || return 1
			ln "${live}/db/${runtime_file}" "${stage}/db/${runtime_file}" || return 1
		fi
	done
	# Retire the pre-rename marker even when the source tree has no db/ directory.
	rm -f "${stage}/db/output.log.generation" || return 1
	return 0
}

function _updatedashboard() {
	_info "Updating QuickBox dashboard..."

	local backup_root backup_dir required lap
	local -a backup_paths=(
		/etc/nginx/apps/dashboard.conf
		/etc/nginx/snippets/proxy.conf
		/etc/nginx/snippets/quickbox-ws-gateway.conf
		/etc/systemd/system/quickbox-ws.service
		/etc/quickbox/ws.secret
		/srv/dashboard/db/ws.secret
		/srv/dashboard/db/nginx-ws-gateway.conf
	)

	# qbUpdate creates one complete set before the service stage. Standalone
	# invocation (tests or manual runs) keeps the local fallback and reports the
	# copy it made; during an update the driver already named the shared one.
	backup_dir="${update_backup_dir:-}"
	if [[ -n "${backup_dir}" ]]; then
		for required in "${backup_paths[@]}"; do
			if ! _qbBackupHasPath "${backup_dir}" "${required}"; then
				_error "Shared update backup misses ${required}: ${backup_dir}"
				return 1
			fi
		done
	else
		backup_root=$(_qbBackupRoot) || return 1
		backup_dir=$(_dashboardBackupDir "${backup_root}/$(date +%Y%m%d-%H%M%S)-dashboard")
		if ! _dashboardBackup "${backup_dir}" "${backup_paths[@]}"; then
			_error "Failed to create a rollback backup"
			return 1
		fi
		_info "Rollback backup: ${backup_dir}"
	fi
	# Build the full replacement away from the live tree. Preserve runtime state,
	# but keep the previous executable payload and dependencies until health passes.
	local stage_dir previous_dir activated=0
	stage_dir=$(mktemp -d /srv/.dashboard-stage.XXXXXX) || return 1
	previous_dir="${stage_dir}.previous"
	if ! _dashboardPrepareStage /srv/dashboard "${stage_dir}" "${local_setup_dashboard}"; then
		rm -rf "${stage_dir}"; _error "Failed to prepare staged dashboard files and dependencies"; return 1
	fi

	_restoreDashboardRelease() {
		local failed=0
		if [[ ${activated} -eq 1 ]]; then
			if mv /srv/dashboard "${stage_dir}" && mv "${previous_dir}" /srv/dashboard; then
				activated=0
			else
				_error "Cannot restore dashboard tree; retain ${previous_dir} and ${stage_dir} for recovery"
				return 1
			fi
		fi
		_dashboardRestore "${backup_dir}" /etc/nginx/apps/dashboard.conf || failed=1
		_dashboardRestore "${backup_dir}" /etc/nginx/snippets/proxy.conf || failed=1
		_dashboardRestore "${backup_dir}" /etc/nginx/snippets/quickbox-ws-gateway.conf || failed=1
		_dashboardRestore "${backup_dir}" /etc/systemd/system/quickbox-ws.service || failed=1
		_dashboardRestore "${backup_dir}" /etc/quickbox/ws.secret || failed=1
		_dashboardRestore "${backup_dir}" /srv/dashboard/db/ws.secret || failed=1
		_dashboardRestore "${backup_dir}" /srv/dashboard/db/nginx-ws-gateway.conf || failed=1
		if [[ ${failed} -eq 0 ]]; then
			# Never activate a mixture when restoring one of the paired files failed.
			if systemctl daemon-reload >>"${OUTTO}" 2>&1 && nginx -t >>"${OUTTO}" 2>&1; then
				systemctl restart quickbox-ws.service >>"${OUTTO}" 2>&1 &&
					systemctl is-active --quiet quickbox-ws.service >>"${OUTTO}" 2>&1 &&
					nginx -s reload >>"${OUTTO}" 2>&1 || failed=1
			else
				failed=1
			fi
		fi
		if [[ ${failed} -eq 0 ]]; then _warning "Rollback completed successfully"; else _error "Rollback was incomplete; inspect ${backup_dir} and update log"; fi
		return "${failed}"
	}

	# 1. Fix the shared proxy snippet first. The new authentication compares the
	#    Origin against the real Host header, so the proxy must forward it before
	#    the new runtime starts.
	lap=$(_qbNowMs)
	if ! _qbRunHelper "Failed to migrate the nginx proxy snippet" \
		bash /usr/local/bin/quickbox/system/auxiliary/qbNginxProxyMigrate \
		--template "${local_setup_template}nginx/proxy.conf"; then
		_restoreDashboardRelease; return 1
	fi
	_qbReportLap "nginx proxy snippet" "${lap}"

	# 2. Move the gateway secret and the injected header into root-managed paths
	#    before the dashboard config starts referencing them.
	lap=$(_qbNowMs)
	if ! _qbRunHelper "Failed to prepare the WS gateway secret" \
		bash /usr/local/bin/quickbox/system/auxiliary/qbEnsureWsGateway; then
		_restoreDashboardRelease; return 1
	fi
	_qbReportLap "ws gateway secret" "${lap}"


	# 4. Install the dashboard vhost (user authentication, no loopback bypass).
	lap=$(_qbNowMs)
	if ! \cp -f "${local_setup_template}nginx/dashboard.conf.template" /etc/nginx/apps/dashboard.conf; then
		_error "Failed to install the dashboard nginx config"
		_restoreDashboardRelease; return 1
	fi
	username=$(cut -d: -f1 < /root/.admin.info)
	if ! python3 - "/etc/nginx/apps/dashboard.conf" "/etc/htpasswd.d/htpasswd.${username}" <<'PYEOF'
import re
import subprocess
import sys

path = sys.argv[1]
htpasswd_path = sys.argv[2]


def auth_snippet(mode: str) -> list[str]:
	output = subprocess.check_output(
		["bash", "/usr/local/bin/quickbox/system/auxiliary/qbNginxAuth", mode, htpasswd_path, "    "],
		text=True,
	)
	return [line + "\n" for line in output.rstrip("\n").split("\n") if line]


with open(path, encoding="utf-8") as f:
	lines = f.readlines()

plain_auth = auth_snippet("plain")
proxy_auth = auth_snippet("proxy")
location_path = ""
out = []
i = 0

while i < len(lines):
	line = lines[i]
	location_match = re.match(r"\s*location\s+(?:[=~*^~]+\s+)?(\S+)\s*\{", line)
	if location_match:
		location_path = location_match.group(1)

	out.append(line)
	i += 1

	# New template marker: replaces the copied basic auth block.
	if re.match(r"\s*#\s*qb-auth-begin\s*$", line):
		while i < len(lines) and re.match(r"\s*auth_basic(?:_user_file)?\b", lines[i]):
			i += 1
		if location_path == "/db/":
			out.extend(plain_auth)
		else:
			out.extend(proxy_auth)
		continue

	# Legacy template: the auth block followed "deny all;" directly.
	if (re.match(r"\s*deny\s+all;", line) and i < len(lines)
		and re.match(r"\s*auth_basic(?:_user_file)?\b", lines[i])):
		while i < len(lines) and re.match(r"\s*auth_basic(?:_user_file)?\b", lines[i]):
			i += 1
		if location_path == "/db/":
			out.extend(plain_auth)
		else:
			out.extend(proxy_auth)

with open(path, "w", encoding="utf-8") as f:
	f.writelines(out)
PYEOF
	then
		_error "Failed to apply the dashboard authentication config"
		_restoreDashboardRelease; return 1
	fi
	if ! grep -qE 'auth_(basic|request)' /etc/nginx/apps/dashboard.conf; then
		_error "The dashboard config has no user authentication directive"
		_restoreDashboardRelease; return 1
	fi
	_qbReportLap "dashboard vhost and auth" "${lap}"

	# 5. Ownership: code and execution policy stay root owned, only the runtime
	#    state directories stay writable by the service user.
	lap=$(_qbNowMs)
	if ! chown -R root:root "${stage_dir}"; then
		_error "Failed to reset dashboard ownership"
		_restoreDashboardRelease; return 1
	fi
	if ! chown -R www-data:www-data "${stage_dir}/db" "${stage_dir}/skins"; then
		_error "Failed to grant the service user its runtime directories"
		_restoreDashboardRelease; return 1
	fi
	_qbReportLap "ownership" "${lap}"

	# 6. Dependencies: keep the previous tree so a failed install cannot leave a
	#    half-populated node_modules behind.
	# Swap directory names on the same filesystem. Keep rollback tree until health passes.
	lap=$(_qbNowMs)
	if ! mv /srv/dashboard "${previous_dir}" || ! mv "${stage_dir}" /srv/dashboard; then
		[[ -d /srv/dashboard ]] || mv "${previous_dir}" /srv/dashboard
		_error "Failed to activate staged dashboard"
		_restoreDashboardRelease; return 1
	fi
	activated=1
	_qbReportLap "activation" "${lap}"

	# 7. Service unit.
	lap=$(_qbNowMs)
	if ! \cp -f "${local_setup_template}systemd/quickbox-ws.service.template" /etc/systemd/system/quickbox-ws.service; then
		_error "Failed to install the quickbox-ws service unit"
		_restoreDashboardRelease; return 1
	fi
	if ! _execute "systemctl daemon-reload"; then
		_error "systemctl daemon-reload failed"
		_restoreDashboardRelease; return 1
	fi
	if ! _execute "systemctl enable quickbox-ws.service"; then
		_error "Failed to enable quickbox-ws.service"
		_restoreDashboardRelease; return 1
	fi

	# 8. Validate the proxy configuration before restarting anything.
	if ! _execute "nginx -t"; then
		_error "nginx configuration test failed"
		_restoreDashboardRelease; return 1
	fi

	if ! _execute "systemctl restart quickbox-ws.service"; then
		_error "Failed to restart quickbox-ws.service"
		_restoreDashboardRelease
		return 1
	fi

	if ! _execute "systemctl is-active --quiet quickbox-ws.service"; then
		_error "quickbox-ws.service is not running after the restart"
		_restoreDashboardRelease
		return 1
	fi
	_qbReportLap "service unit and restart" "${lap}"

	lap=$(_qbNowMs)
	if ! _execute "nginx -s reload"; then
		_error "nginx reload failed"
		_restoreDashboardRelease
		return 1
	fi

	if [[ -f /srv/dashboard/db/.smoked.lock ]]; then
		_execute "bash /usr/local/bin/quickbox/system/theme/themeSelect-smoked" || { _restoreDashboardRelease; return 1; }
	elif [[ -f /srv/dashboard/db/.defaulted.lock ]]; then
		_execute "bash /usr/local/bin/quickbox/system/theme/themeSelect-defaulted" || { _restoreDashboardRelease; return 1; }
	else
		_execute "bash /usr/local/bin/quickbox/system/theme/themeSelect-smoked" || { _restoreDashboardRelease; return 1; }
	fi
	_qbReportLap "nginx reload and theme" "${lap}"

	# 9. Verify through the real paths, not just process liveness. The health
	#    check retries, so its duration is the best signal for a slow start.
	#    It keeps its own verdict line: the individual probes only surface when
	#    one of them fails or the update runs with --verbose.
	lap=$(_qbNowMs)
	local health_output health_deadline=$((SECONDS + 5))
	local -a health_args=(--expect-proxy)
	if _qbIsVerbose; then
		health_args+=(--verbose)
	fi
	# Reload returns before old nginx workers stop accepting connections. Require
	# the complete health verdict to pass, allowing a short activation retry window.
	while ! health_output=$(bash /usr/local/bin/quickbox/system/auxiliary/qbWsHealthCheck "${health_args[@]}" 2>&1); do
		if (( SECONDS >= health_deadline )); then
			printf '%s\n' "${health_output}" >&2
			_error "Dashboard health check failed"
			_restoreDashboardRelease
			_warning "Rollback backup kept at ${backup_dir}"
			return 1
		fi
		sleep 0.1
	done
	printf '%s\n' "${health_output}" >&2
	_qbReportLap "health check" "${lap}"
	rm -rf "${previous_dir}" "${stage_dir}"

	# 10. Only now remove the legacy gateway copies: nginx no longer includes
	#     them and the new runtime reads the protected location. The dashboard
	#     is already serving, so a failure here must not undo the update.
	lap=$(_qbNowMs)
	_qbRunHelper "Failed to clean up the legacy gateway files" \
		bash /usr/local/bin/quickbox/system/auxiliary/qbEnsureWsGateway --cleanup-legacy || true
	_qbReportLap "legacy gateway cleanup" "${lap}"

	touch /install/.quickbox-ws.lock
	_success "QuickBox dashboard updated"
	return 0
}

function _updatelanguage() {
	_info "Updating QuickBox language..."
	dashlang=$(find /install -type f | grep -e "lang.*.lock" | cut -d "." -f 2)
	if ! bash /usr/local/bin/quickbox/system/box lang "$dashlang"; then
		_warning "Failed to update language: $dashlang, fallback to en"
		if ! bash /usr/local/bin/quickbox/system/box lang en; then
			_error "Failed to update the dashboard language"
			return 1
		fi
	fi
	_success "QuickBox language updated"
	return 0
}
