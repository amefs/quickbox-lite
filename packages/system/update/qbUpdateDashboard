function _execute() {
	($1 >>"${OUTTO}" 2>&1)
}
function _print() {
	printf "${_norm}%s${_norm}\n" "$@"
	printf "%s\n" "$@" >>"${OUTTO}"
}
function _info() {
	printf "${_cyan}➜ %s${_norm}\n" "$@"
	printf ">> Info: %s\n" "$@" >>"${OUTTO}"
}
function _success() {
	printf "${_green}✓ %s${_norm}\n" "$@"
	printf ">> Success: %s\n" "$@" >>"${OUTTO}"
}
function _warning() {
	printf "${_tan}⚠ %s${_norm}\n" "$@"
	printf ">> Warning: %s\n" "$@" >>"${OUTTO}"
}
function _error() {
	printf "${_red}✗ %s${_norm}\n" "$@"
	printf ">> Error: %s\n" "$@" >>"${OUTTO}"
}

function _updatedashboard() {
	_info "Updating QuickBox dashboard..."
	# Update dashboard config
	cd /srv/dashboard || exit 1
	_execute "rsync -aP --delete --exclude=output.log --exclude=interface.txt --exclude=master.txt --exclude=ws.secret --exclude=nginx-ws-gateway.conf --exclude=.smoked.lock --exclude=.defaulted.lock --exclude=custom.css ${local_setup_dashboard}* /srv/dashboard"
	username=$(cat /root/.admin.info | cut -d: -f1)
	\cp -f ${local_setup_template}nginx/dashboard.conf.template /etc/nginx/apps/dashboard.conf
	python3 - "/etc/nginx/apps/dashboard.conf" "/etc/htpasswd.d/htpasswd.${username}" <<'PYEOF'
import re
import subprocess
import sys

path = sys.argv[1]
htpasswd_path = sys.argv[2]


def auth_snippet(mode: str) -> list[str]:
	output = subprocess.check_output(
		["bash", "/usr/local/bin/quickbox/system/auxiliary/qbNginxAuth", mode, htpasswd_path, "    "],
		text=True,
	)
	return [line + "\n" for line in output.rstrip("\n").split("\n") if line]


with open(path, encoding="utf-8") as f:
	lines = f.readlines()

plain_auth = auth_snippet("plain")
proxy_auth = auth_snippet("proxy")
location_path = ""
out = []
i = 0

while i < len(lines):
	line = lines[i]
	location_match = re.match(r"\s*location\s+(?:[=~*^~]+\s+)?(\S+)\s*\{", line)
	if location_match:
		location_path = location_match.group(1)

	out.append(line)
	i += 1

	if re.match(r"\s*deny\s+all;", line):
		while i < len(lines) and re.match(r"\s*auth_basic(?:_user_file)?\b", lines[i]):
			i += 1
		if location_path == "/db/":
			out.extend(plain_auth)
		else:
			out.extend(proxy_auth)

with open(path, "w", encoding="utf-8") as f:
	f.writelines(out)
PYEOF
	bash /usr/local/bin/quickbox/system/auxiliary/qbEnsureWsGateway
	cd /srv/dashboard/ws || exit 1
	_execute "npm ci --production"
	\cp -f ${local_setup_template}systemd/quickbox-ws.service.template /etc/systemd/system/quickbox-ws.service
	_execute "systemctl daemon-reload"
	_execute "systemctl enable quickbox-ws.service"
	_execute "systemctl restart quickbox-ws.service"
	touch /install/.quickbox-ws.lock

	if [[ -f /srv/dashboard/db/.smoked.lock ]]; then
		_execute "bash /usr/local/bin/quickbox/system/theme/themeSelect-smoked"
	elif [[ -f /srv/dashboard/db/.defaulted.lock ]]; then
		_execute "bash /usr/local/bin/quickbox/system/theme/themeSelect-defaulted"
	else
		_execute "bash /usr/local/bin/quickbox/system/theme/themeSelect-smoked"
	fi
	chown -R www-data:www-data /srv/dashboard
	_execute "nginx -s reload"
	_success "QuickBox dashboard updated"
}

function _updatelanguage() {
	_info "Updating QuickBox language..."
	dashlang=$(find /install -type f | grep -e "lang.*.lock" | cut -d "." -f 2)
	if ! bash /usr/local/bin/quickbox/system/box lang "$dashlang"; then
		_warning "Failed to update language: $dashlang, fallback to en"
		bash /usr/local/bin/quickbox/system/box lang en
	fi
	_success "QuickBox language updated"
}