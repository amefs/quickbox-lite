################################################################################
# HELP FUNCTIONS
################################################################################
export NEWT_COLORS='
root=,black
window=,lightgray
shadow=,color8
title=color8,
checkbox=,magenta
entry=,color8
label=blue,
actlistbox=,magenta
actsellistbox=,magenta
helpline=,magenta
roottext=,magenta
emptyscale=magenta
disabledentry=magenta,
'

_norm=$(tput sgr0)
_red=$(tput setaf 1)
_green=$(tput setaf 2)
_tan=$(tput setaf 3)
_cyan=$(tput setaf 6)

function _execute() {
	($1 >>"${OUTTO}" 2>&1)
}
function _print() {
	printf "${_norm}%s${_norm}\n" "$@"
}
function _info() {
	printf "${_cyan}➜ %s${_norm}\n" "$@"
}
function _success() {
	printf "${_green}✓ %s${_norm}\n" "$@"
}
function _warning() {
	printf "${_tan}⚠ %s${_norm}\n" "$@"
}
function _error() {
	printf "${_red}✗ %s${_norm}\n" "$@"
}
################################################################################
# SCRIPT FUNCTIONS
################################################################################
# Every package operation writes the shared Dashboard log, so it starts a new
# log the way `box update quickbox` does: clean_log publishes a new epoch and
# then truncates the file in place, which is what tells the Dashboard its byte
# offset is stale. Without it the dialog shows the previous operation above
# this one.
#
# The operation lock stays on descriptor 7 for the package script; contention
# returns 75.
function _startOperationLog() {
	local lockfile="${QUICKBOX_OPERATION_LOCK:-/run/lock/quickbox-operation.lock}"
	local prevApp
	if ! { exec 7>"${lockfile}"; } 2>/dev/null; then
		_warning "Cannot open the operation lock; continuing without it: ${lockfile}"
		return 0
	fi
	if command -v flock >/dev/null 2>&1 && ! flock -n 7; then
		exec 7>&-
		_error "Another QuickBox operation is running; try again when it finishes"
		return 75
	fi
	if [[ -f "/install/.install.lock" ]]; then
		prevApp=$(cat /install/.install.lock 2>/dev/null || true)
		exec 7>&-
		_error "${prevApp:-Another operation} is running; try again when it finishes"
		return 75
	fi
	if ! bash "$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/auxiliary/clean_log"; then
		_warning "Failed to start a new installation log"
	fi
	return 0
}

# Writes one dashboard db file as www-data through an atomic rename.
function _writeDashboardDbFile() {
	local name="$1" value="$2"
	local dir="${QUICKBOX_DASHBOARD_DB:-/srv/dashboard/db}" target tmp
	target="${dir}/${name}"
	tmp=$(mktemp "${dir}/.${name}.XXXXXX") || return 1
	if ! printf '%s\n' "${value}" >"${tmp}" ||
		! chown www-data:www-data "${tmp}" ||
		! chmod 0640 "${tmp}" ||
		! mv -f "${tmp}" "${target}"; then
		rm -f "${tmp}"
		return 1
	fi
	return 0
}

function _batchInstall() {
	applist=()
	locks=$(find /usr/local/bin/quickbox/package/install -type f -printf "%f\n" | cut -d "-" -f 2-3 | grep -v "Template\|lecert\|denyhosts\|fail2ban" | sort -d)
	for i in "${locks[@]}"; do
		app=${i}
		for file in /install/.*."$app".lock; do
			if [ ! -f "/install/${file}" ]; then
				if [ ! -f "/install/.$app.lock" ]; then
					applist+=("$i" '""')
				fi
			fi
		done
	done
	installlist=$(whiptail --title "Install Software" --checklist --noitem --separate-output "Make some choices:" 20 28 14 "${applist[@]}" 3>&1 1>&2 2>&3)
	echo "Batch Installing..."
	for i in "${installlist[@]}"; do
		source /usr/local/bin/quickbox/package/install/installpackage-"$i"
	done
}

function _help() {
	# print help info
	echo -e "\nQuickBox Lite Cli Tools"
	echo -e "\nUsage: \n$(basename "$0") COMMAND"
	echo -e "\nOptions:\n"
	echo "install <appname>                 install applications, leave appname"
	echo "                                  blank to use batch install"
	echo "remove <appname>                  remove installed application"
	echo "update <appname>                  upgrade installed application"
	echo "update quickbox [--only-core] [--branch <branch>] [--verbose]"
	echo "                                  upgrade QuickBox from the specified branch on origin"
	echo "revert [--list] [--yes] [COMMIT]  restore and reinstall a QuickBox commit"
	echo "lang <da|de|en|es|fr|zh>          change dashboard language"
	echo "clean <mem|log>                   clean memory or installation log"
	echo "fix <dpkg|interface|home>         fix your setting"
	echo "set <interface|passwd|cdn>        change interface setting/password"
	echo "iotest                            run IO test"
	echo "abort                             stop the running installation or update"
	echo "troubleshoot                      generate log for troubleshoot"
	echo "unban <IP adress>                 remove a IP/all IP from banned list"
	echo "switch-branch <branch>            switch branch and update QuickBox"
	echo "enable-dev|disable-dev            switch to development or master"
	echo ""
	echo "help                              display this help and exit"
}
################################################################################
# ARGUMENT SETTING
################################################################################
resolver=$1

if [[ $resolver == "lang" ]]; then
	langname=$2
	langscript=""
	case $langname in
	"da" | "dansk" | "danish" | "lang_da") langscript="lang_da" ;;
	"de" | "deutsch" | "germany" | "lang_de") langscript="lang_de" ;;
	"en" | "en-us" | "english" | "lang_en") langscript="lang_en" ;;
	"es" | "spanish" | "lang_es") langscript="lang_es" ;;
	"fr" | "french" | "lang_fr") langscript="lang_fr" ;;
	"zh" | "zh-cn" | "chinese" | "lang_zh-cn" | "lang_zh") langscript="lang_zh" ;;
	*)
	echo -e "\nQuickBox Lite Cli Tools"
	echo -e "\nUsage: \n$(basename "$0") lang LANGUAGE"
	echo -e "\nAvailable language:\n"
	echo  "danish"
	echo  "germany"
	echo  "english"
	echo  "spanish"
	echo  "french"
	echo  "chinese"
	exit 1
	;;
	esac
	bash /usr/local/bin/quickbox/system/lang/"langSelect-${langscript}"
	exit $?
fi

if [[ $resolver == "install" ]]; then
	extraarg="${*:2}"
	appname=$2
	if [[ -z $extraarg ]]; then
		_batchInstall
	elif [[ $appname == "bbr" || $appname == "BBR" ]]; then
		_startOperationLog || exit $?
		bash /usr/local/bin/quickbox/system/auxiliary/install-BBR.sh "${*:3}"
		exit $?
	else
		if [[ -f /usr/local/bin/quickbox/package/install/installpackage-"${appname}" ]]; then
			_startOperationLog || exit $?
			bash /usr/local/bin/quickbox/package/install/installpackage-"${appname}" ${*:3}
			exit $?
		else
			locks=$(find /usr/local/bin/quickbox/package/install -type f -printf "%f\n" | cut -d "-" -f 2-3 | grep -v "Template" | sort -d)
			_error "${appname} Installer not exist"
			echo -e "\nQuickBox Lite Cli Tools"
			echo -e "\nUsage: \n$(basename "$0") install PACKAGE"
			echo -e "\nAvailable installer:\n"
			for i in "${locks[@]}"; do
				echo "${i}"
			done
		fi
	fi
fi

if [[ $resolver == "remove" ]]; then
	extraarg="${*:2}"
	appname=$2
	if [[ -z $extraarg ]]; then
		_error "Nothing will be removed"
	else
		if [[ -f /usr/local/bin/quickbox/package/remove/removepackage-"${appname}" ]]; then
			_startOperationLog || exit $?
			bash /usr/local/bin/quickbox/package/remove/removepackage-"${appname}" ${*:3}
			exit $?
		else
			locks=$(find /usr/local/bin/quickbox/package/remove -type f -printf "%f\n" | cut -d "-" -f 2-3 | grep -v "Template" | sort -d)
			_error "${appname} Remover not exist"
			echo -e "\nQuickBox Lite Cli Tools"
			echo -e "\nUsage: \n$(basename "$0") remove PACKAGE"
			echo -e "\nAvailable remover:\n"
			for i in "${locks[@]}"; do
				echo "${i}"
			done
		fi
	fi
fi

if [[ $resolver == "update" ]]; then
	appname=$2
	extraarg=${*:2}
	if [[ $appname == "quickbox" ]]; then
		bash /usr/local/bin/quickbox/system/qbUpdate "${@:3}"
		exit $?
	elif [[ $appname == "revert" ]]; then
		bash /usr/local/bin/quickbox/system/update/qbUpdateRevert "${@:3}"
		exit $?
	elif [[ -n $extraarg ]]; then
		if [[ -f /usr/local/bin/quickbox/package/update/updatepackage-"${appname}" ]]; then
			_startOperationLog || exit $?
			bash /usr/local/bin/quickbox/package/update/updatepackage-"${appname}" ${*:3}
			exit $?
		else
			locks=$(find /usr/local/bin/quickbox/package/update -type f -printf "%f\n" | cut -d "-" -f 2-3 | grep -v "Template" | sort -d)
			_error "${appname} Updater not exist"
			echo -e "\nQuickBox Lite Cli Tools"
			echo -e "\nUsage: \n$(basename "$0") update PACKAGE"
			echo -e "\nAvailable updater:\n"
			for i in "${locks[@]}"; do
				echo "${i}"
			done
		fi
	else
		locks=$(find /usr/local/bin/quickbox/package/update -type f -printf "%f\n" | cut -d "-" -f 2-3 | grep -v "Template" | sort -d)
		_error "Nothing to be updated"
		echo -e "\nQuickBox Lite Cli Tools"
		echo -e "\nUsage: \n$(basename "$0") update PACKAGE"
		echo -e "\nAvailable updater:\n"
		for i in "${locks[@]}"; do
			echo "${i}"
		done
	fi
fi

if [[ $resolver == "clean" ]]; then
	command=$2
	if [[ $command == "mem" || $command == "memory" ]]; then
		bash /usr/local/bin/quickbox/system/auxiliary/clean_mem
	elif [[ $command == "log" ]]; then
		bash /usr/local/bin/quickbox/system/auxiliary/clean_log
	else
		_error "${appname} Cleaner not exist"
		echo -e "\nQuickBox Lite Cli Tools"
		echo -e "\nUsage: \n$(basename "$0") update PACKAGE"
		echo -e "\nAvailable cleaner:\n"
		echo "memory"
		echo "log"
	fi
fi

if [[ $resolver == "abort" ]]; then
	bash /usr/local/bin/quickbox/system/auxiliary/qbAbortTask
	exit $?
fi

if [[ $resolver == "troubleshoot" ]]; then
	bash /usr/local/bin/quickbox/system/auxiliary/logCollector.sh
fi

if [[ $resolver == "set" ]]; then
	command=$2
	case $command in
	"interface")
		if ! _writeDashboardDbFile interface.txt "$3"; then
			_error "Failed to update the dashboard interface"
			exit 1
		fi
		bash /usr/local/bin/quickbox/system/auxiliary/set_interface
		;;
	"passwd" | "password")
		bash /usr/local/bin/quickbox/system/users/changePass -p ${*:3}
		;;
	"cdn")
		case "$3" in
			"cf") echo "cf" > /install/.cdn.lock ;;
			"sf") echo "sf" > /install/.cdn.lock ;;
			"osdn") echo "osdn" > /install/.cdn.lock ;;
			"github") echo "github" > /install/.cdn.lock ;;
			*) echo "github" > /install/.cdn.lock ;;
		esac
		;;
	*)
		_error "Nothing to be set"
		echo -e "\nQuickBox Lite Cli Tools"
		echo -e "\nUsage: \n$(basename "$0") set FUNCTION"
		echo -e "\nAvailable variable:\n"
		echo "interface"
		echo "password"
		;;
	esac
fi

if [[ $resolver == "fix" ]]; then
	command=$2
	case $command in
	"dpkg" | "lock") bash /usr/local/bin/quickbox/system/auxiliary/fixDpkg ;;
	"interface") bash /usr/local/bin/quickbox/system/auxiliary/set_interface ;;
	"home") bash /usr/local/bin/quickbox/system/auxiliary/fixHome ${*:3} ;;
	*)
		_error "Nothing to be fixed"
		echo -e "\nQuickBox Lite Cli Tools"
		echo -e "\nUsage: \n$(basename "$0") fix FUNCTION"
		echo -e "\nAvailable variable:\n"
		echo "dpkg"
		echo "interface"
		echo "home"
	;;
	esac
fi

if [[ $resolver =~ ("iotest"|"disktest") ]]; then
	bash /usr/local/bin/quickbox/system/auxiliary/iotest ${*:2}
fi

if [[ $resolver == "unban" ]]; then
	if [[ -f /install/.denyhosts.lock ]]; then
		bash /usr/local/bin/quickbox/system/auxiliary/denyunban ${*:2}
	fi
	if [[ -f /install/.fail2ban.lock ]]; then
		bash /usr/local/bin/quickbox/system/auxiliary/failunban ${*:2}
	fi
fi

if [[ $resolver == "enable-dev" || $resolver == "disable-dev" || $resolver == "switch-branch" ]]; then
	case "$resolver" in
		enable-dev) branch=development ;;
		disable-dev) branch=master ;;
		*) branch=${2:-} ;;
	esac
	if [[ -z ${branch} || ${branch} == -* ]] || ! git check-ref-format --branch "${branch}" >/dev/null 2>&1; then
		_error "Invalid branch name"
		exit 2
	fi
	/usr/local/bin/quickbox/system/box update quickbox --only-core --branch "${branch}"
	exit $?
fi

if [[ $resolver == "revert" ]]; then
	bash /usr/local/bin/quickbox/system/update/qbUpdateRevert "${@:2}"
	exit $?
fi

if [[ $resolver == "help" ]]; then
	_help
	exit 0
fi

################################################################################
# ERROR HANDLER
################################################################################

if [[ ! $resolver =~ ("lang"|"install"|"remove"|"update"|"revert"|"abort"|"clean"|"troubleshoot"|"set"|"fix"|"iotest"|"disktest"|"unban"|"enable-dev"|"disable-dev"|"switch-branch"|"help") ]]; then
	_error "Command not exist!"
	_help
	exit 1
fi
