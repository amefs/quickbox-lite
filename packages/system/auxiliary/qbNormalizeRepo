#!/bin/bash
if [ "${QB_NORMALIZE_BOOTSTRAP:-0}" != 1 ] && [ "${BASH_SOURCE[0]:-}" = "$0" ] && grep -q $'\r' "$0" 2>/dev/null; then sed 's/\r$//' "$0" >"${0}.$$.tmp" && mv "${0}.$$.tmp" "$0" || exit 1; QB_NORMALIZE_BOOTSTRAP=1 exec bash "$0" "$@" ; fi #
