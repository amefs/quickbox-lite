function _updatedashboard() {
	\cp --remove-destination -fR ${local_themes}smoked/skins/* ${dashboard}skins || return 1
	rm -rf ${dashboard}db/.defaulted.lock >/dev/null 2>&1 || return 1
	printf "" >${dashboard}db/.smoked.lock || return 1
	service nginx reload >/dev/null 2>&1 || return 1
	sleep 5

}

local_themes=/etc/QuickBox/setup/themes/
dashboard=/srv/dashboard/

_updatedashboard || exit 1
